{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "us-central1" }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\"/.. run build",
      "cp \"$RESOURCE_DIR\"/../dist/server.cjs \"$RESOURCE_DIR\"/bundled-server.cjs"
    ]
  },
  "firestore": [
    {
      "database": "ai-studio-bunaaipremiumcof-4a662efd-cc62-4ab6-a8ad-cd1f24a9e707",
      "rules": "firestore.rules"
    }
  ]
}
